# Copy the values below into the project root .env file (adamrit/.env)
# Run setup-oauth.js once to get the GMAIL_REFRESH_TOKEN

GMAIL_CLIENT_ID=your_google_oauth_client_id_here
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_from_setup_oauth
GMAIL_USER_EMAIL=info@hopehospital.com

# Anthropic API key for Claude (claude-sonnet-4-6)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
