# Re-phrase sidecar configuration (lives ONLY on the VPS — never commit the real .env)

# Claude key the sidecar uses to rephrase/regenerate. Get one at:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Shared secret the app must send as the `x-sidecar-key` header. REQUIRED.
# Generate a long random value, e.g.:  openssl rand -hex 32
# Put the SAME value in the app env as VITE_REPHRASE_SIDECAR_KEY.
SIDECAR_SHARED_SECRET=

# Comma-separated browser origins allowed to call this sidecar (CORS).
# Use your app's real origins; "*" allows any (fine for testing, tighten in prod).
# Example: https://localhost:8080,https://app.your-domain.com
CORS_ORIGINS=*

# Port the Node process listens on (Caddy/nginx terminates HTTPS in front of this).
PORT=8787
