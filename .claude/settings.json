{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh auth:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx vite:*)",
      "Bash(npx supabase:*)",
      "Bash(supabase status:*)",
      "Bash(supabase projects:*)",
      "Bash(node:*)",
      "Bash(grep:*)",
      "Bash(curl:*)",
      "Bash(vercel ls:*)",
      "Bash(vercel env:*)",
      "Bash(vercel link:*)",
      "Bash(vercel --prod --yes)",
      "WebSearch"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/require-pull-before-push.sh\"",
            "timeout": 30,
            "statusMessage": "Checking origin/main before push..."
          }
        ]
      }
    ]
  }
}
