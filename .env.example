# Supabase Configuration
VITE_SUPABASE_URL=https://xvkxccqaopbnkvwgyfjv.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh2a3hjY3Fhb3Bibmt2d2d5Zmp2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDc4MjMwMTIsImV4cCI6MjA2MzM5OTAxMn0.z9UkKHDm4RPMs_2IIzEPEYzd3-sbQSF6XpxaQg3vZhU

# Supabase Service Role Key (server-side only — NEVER expose in frontend)
# Get from: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Tally Data Export Sync (for sync-tally-export.js)
# Set this to the VPN-mounted folder path where Tally exports XML files
# Windows:  TALLY_EXPORT_DIR=Z:\DataExport
# macOS:    TALLY_EXPORT_DIR=/Volumes/DataExport
# Linux:    TALLY_EXPORT_DIR=/mnt/tally-export
TALLY_EXPORT_DIR=./tally-exports

# OpenAI Configuration for AI features
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Gemini AI runs server-side via the `ai-proxy` Edge Function. The real key
# lives in Supabase secrets (GEMINI_API_KEY) — set it with:
#   supabase secrets set GEMINI_API_KEY=<key>
# This client-side value is only a non-secret presence sentinel for AI guards.
VITE_GEMINI_API_KEY=managed-server-side

# Optional: VPS sidecar that performs billing-email AI re-phrase/regenerate server-side.
# When set, the browser calls this instead of Gemini directly, so no LLM key lives in the
# frontend bundle. Must be HTTPS (browsers block https->http). Leave unset to use the
# free built-in local templates. See rephrase-sidecar/README.md.
VITE_REPHRASE_SIDECAR_URL=https://sidecar.your-domain.com
# Shared secret sent as the x-sidecar-key header — must match SIDECAR_SHARED_SECRET on the VPS.
VITE_REPHRASE_SIDECAR_KEY=

# Double Tick WhatsApp API Configuration (for automated notifications)
DOUBLETICK_API_KEY=your_doubletick_api_key_here
DOUBLETICK_PHONE=your_hospital_phone_number_here

# Claude Code Auto-Confirm Configuration (optional)
# Uses file-based config by default (.claude/auto-confirm-config.json)
# AUTO_CONFIRM_ENABLED=false
# AUTO_CONFIRM_AGENT=auto-confirm

# Development settings for Claude Code extensions
# NODE_ENV=development
# DEBUG=claude-code:auto-confirm
# JotForm -> Task Optimizer webhook (server-side only)
# Shared secret the webhook requires as ?secret=... or x-webhook-secret header.
JOTFORM_WEBHOOK_SECRET=
# Optional: override Supabase URL for the webhook (defaults to the public project URL).
SUPABASE_URL=

# Resend API Key — for Task Optimizer email automations
# Get a free key at: https://resend.com (100 emails/day free)
VITE_RESEND_API_KEY=your_resend_api_key_here
