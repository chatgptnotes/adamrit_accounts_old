{
  "name": "adamrit-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Loopback-isolated, keyless sidecar for the Adamrit HMS",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "healthcheck": "node -e \"fetch('http://127.0.0.1:'+(process.env.SIDECAR_PORT||8081)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
  }
}
