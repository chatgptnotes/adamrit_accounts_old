{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/tally-proxy.ts": {
      "maxDuration": 300
    },
    "api/skill-factory-claude.ts": {
      "maxDuration": 120
    },
    "api/ai-proxy.ts": {
      "maxDuration": 120
    },
    "api/partner/nightly-sync.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/deadline-reminders",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/partner/nightly-sync",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/books-health-check",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
